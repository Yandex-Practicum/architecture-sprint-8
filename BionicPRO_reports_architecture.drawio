          <mxGeometry x="640" y="350" width="200" height="160" as="geometry"/>
        </mxCell>

        <mxCell id="api" value="Reports API Service&#xa;/reports?user_id=self&#xa;RBAC: only self" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="900" y="360" width="200" height="120" as="geometry"/>
