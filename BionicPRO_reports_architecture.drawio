  <diagram id="reports-arch" name="Reports Architecture">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="note" value="Airflow ETL объединяет телеметрию (DB) и CRM, формирует витрину в OLAP (ClickHouse). API /reports читает витрину, доступ только своему user_id, UI кнопка вызывает /reports. Период данных ограничен обработанными DAG ранами." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="200" y="80" width="1000" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="crm" value="CRM DB" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#23A2D9;fontColor=#ffffff;strokeColor=#0E7DAD;" vertex="1" parent="1">
          <mxGeometry x="150" y="260" width="160" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="telemetry" value="Telemetry DB (raw)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#23A2D9;fontColor=#ffffff;strokeColor=#0E7DAD;" vertex="1" parent="1">
          <mxGeometry x="150" y="430" width="160" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="airflow" value="Airflow DAGs&#xa;- extract CRM&#xa;- aggregate telemetry per user&#xa;- join -> vitrina&#xa;- schedule (hourly/daily)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="380" y="330" width="220" height="180" as="geometry"/>
