<?xml version="1.0"?>
<clickhouse>
    <!-- Отключаем все системные логи -->
    <query_log remove="remove"/>
    <query_thread_log remove="remove"/>
    <part_log remove="remove"/>
    <metric_log remove="remove"/>
    <asynchronous_metric_log remove="remove"/>
    <session_log remove="remove"/>
    <trace_log remove="remove"/>
    <text_log remove="remove"/>

    <logger>
        <level>error</level>
        <console>true</console>
    </logger>

    <http_port>8123</http_port>
    <tcp_port>9000</tcp_port>
    <listen_host>0.0.0.0</listen_host>

    <max_connections>4096</max_connections>
    <max_concurrent_queries>100</max_concurrent_queries>

    <!-- отключаем переименование временных файлов -->
    <merge_tree>
        <use_minimalistic_part_header_in_zookeeper>1</use_minimalistic_part_header_in_zookeeper>
        <enable_mixed_granularity_parts>0</enable_mixed_granularity_parts>
    </merge_tree>

    <!-- Используем простую схему хранения -->
    <storage_configuration>
        <disks>
            <default>
                <keep_free_space_bytes>1048576</keep_free_space_bytes>
            </default>
        </disks>
        <policies>
            <default>
                <volumes>
                    <default>
                        <disk>default</disk>
                    </default>
                </volumes>
            </default>
        </policies>
    </storage_configuration>

    <profiles>
        <default>
            <max_memory_usage>10000000000</max_memory_usage>
            <max_bytes_before_external_group_by>0</max_bytes_before_external_group_by>
            <!-- Отключаем временные таблицы на диске -->
            <max_bytes_in_join>0</max_bytes_in_join>
        </default>
    </profiles>
</clickhouse>