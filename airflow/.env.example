# ClickHouse Configuration
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse
CLICKHOUSE_DATABASE=bionicpro

# PostgreSQL Telemetry Database
POSTGRES_TELEMETRY_HOST=postgres-telemetry
POSTGRES_TELEMETRY_PORT=5432
POSTGRES_TELEMETRY_USER=telemetry
POSTGRES_TELEMETRY_PASSWORD=telemetry
POSTGRES_TELEMETRY_DB=telemetry_db

# PostgreSQL CRM Database
POSTGRES_CRM_HOST=postgres-crm
POSTGRES_CRM_PORT=5432
POSTGRES_CRM_USER=crm
POSTGRES_CRM_PASSWORD=crm
POSTGRES_CRM_DB=crm_db

# Airflow Configuration
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=true
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__WEBSERVER__SECRET_KEY=bionicpro_secret_key_2024
AIRFLOW__WEBSERVER__EXPOSE_CONFIG=true

# Airflow Admin User
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_EMAIL=admin@bionicpro.com

# Logging
AIRFLOW__LOGGING__LOGGING_LEVEL=INFO
AIRFLOW__LOGGING__FAB_LOGGING_LEVEL=WARN

# Security (change in production!)
AIRFLOW__CORE__FERNET_KEY=

# Performance Tuning
AIRFLOW__CORE__MAX_ACTIVE_RUNS_PER_DAG=1
AIRFLOW__CORE__PARALLELISM=32
AIRFLOW__CORE__DAG_CONCURRENCY=16
AIRFLOW__SCHEDULER__MAX_TIS_PER_QUERY=512

# Timezone
AIRFLOW__CORE__DEFAULT_TIMEZONE=UTC

# Database Connections (internal use)
POSTGRES_TELEMETRY_CONN=postgresql://telemetry:telemetry@postgres-telemetry:5432/telemetry_db
POSTGRES_CRM_CONN=postgresql://crm:crm@postgres-crm:5432/crm_db
CLICKHOUSE_CONN=clickhouse://default:clickhouse@clickhouse:9000/bionicpro
