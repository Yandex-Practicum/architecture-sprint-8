<mxfile host="app.diagrams.net">
  <diagram name="C4-Container-CredentialManagement" id="credential-management">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="BionicPRO — Задание 1: управление учётными данными (C4, уровень Container)" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="30" as="geometry" />
        </mxCell>

        <!-- Person -->
        <mxCell id="user" value="Пользователь протеза&#10;[Person]&#10;Пилот BionicPRO, донастраивает протез и смотрит отчёты" style="shape=actor;whiteSpace=wrap;html=1;fillColor=#08427b;strokeColor=#073B6F;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="120" height="100" as="geometry" />
        </mxCell>

        <!-- BionicPRO system boundary -->
        <mxCell id="boundary" value="BionicPRO" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;verticalAlign=top;fontStyle=1;fontSize=14;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="240" y="90" width="980" height="560" as="geometry" />
        </mxCell>

        <mxCell id="spa" value="Frontend SPA&#10;[Container: React]&#10;Не хранит и не видит access/refresh токены — только читает сессионную cookie" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168bd;strokeColor=#0b4884;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="280" y="140" width="220" height="90" as="geometry" />
        </mxCell>

        <mxCell id="bff" value="bionicpro-auth (BFF)&#10;[Container: Spring Boot / Spring Security]&#10;Ведёт Authorization Code + PKCE с Keycloak, хранит токены только на сервере, выдаёт HttpOnly+Secure session cookie, ротирует session id на каждый защищённый запрос" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168bd;strokeColor=#0b4884;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="280" y="280" width="260" height="120" as="geometry" />
        </mxCell>

        <mxCell id="redis" value="Redis&#10;[Container: Cache]&#10;Распределённое хранилище сессий: access/refresh токены, привязка к session id" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#438dd5;strokeColor=#2e6295;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="600" y="290" width="150" height="100" as="geometry" />
        </mxCell>

        <mxCell id="keycloak" value="Keycloak&#10;[Container: Identity Provider]&#10;OIDC + PKCE, обязательный OTP, LDAP user federation, Identity Brokering с Яндекс ID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168bd;strokeColor=#0b4884;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="820" y="140" width="260" height="120" as="geometry" />
        </mxCell>

        <mxCell id="keycloakdb" value="Keycloak DB&#10;[Container: PostgreSQL]&#10;Realm, пользователи, OTP-секреты, импортированные профили Yandex ID" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#438dd5;strokeColor=#2e6295;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="870" y="330" width="160" height="100" as="geometry" />
        </mxCell>

        <mxCell id="reportsapi" value="reports-api&#10;[Container — Задание 2, ещё не реализован]&#10;Будет принимать ту же сессионную cookie от bionicpro-auth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cccccc;strokeColor=#999999;fontColor=#333333;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="460" width="260" height="80" as="geometry" />
        </mxCell>

        <!-- External systems -->
        <mxCell id="ldap" value="OpenLDAP (представительство в другой стране)&#10;[External System]&#10;Локальный источник учётных записей и ролей; PII/медицинские данные не покидают страну представительства" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6c6c6c;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="1200" y="90" width="240" height="120" as="geometry" />
        </mxCell>

        <mxCell id="yandex" value="Яндекс ID&#10;[External System]&#10;Внешний OAuth2 Identity Provider" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6c6c6c;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="1200" y="250" width="240" height="90" as="geometry" />
        </mxCell>

        <!-- Relationships -->
        <mxCell id="e1" value="открывает приложение" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="user" target="spa">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e2" value="GET /api/session, /reports&#10;[HTTPS, только session cookie]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="spa" target="bff">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e3" value="Authorization Code + PKCE (S256)&#10;access_token lifespan ≤ 2 мин" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="bff" target="keycloak">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e4" value="токены/сессии, ротация session id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="bff" target="redis">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e5" value="realm, пользователи, OTP" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="keycloak" target="keycloakdb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e6" value="LDAP bind/search&#10;роли по группам представительства" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="keycloak" target="ldap">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e7" value="OAuth2 Identity Brokering&#10;с согласия пользователя" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="keycloak" target="yandex">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e8" value="(Задание 2) session cookie" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;" edge="1" parent="1" source="bff" target="reportsapi">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="Сплошная граница = существующий/реализуемый в этом заходе компонент. Пунктир = вне рамок текущего захода (Задание 2)." style="text;html=1;fontSize=11;fontColor=#666666;align=left;" vertex="1" parent="1">
          <mxGeometry x="280" y="620" width="700" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
