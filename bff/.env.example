PORT=4000
NODE_ENV=development

# Keycloak Configuration
# KEYCLOAK_URL - internal URL for server-to-server communication (inside Docker)
KEYCLOAK_URL=http://keycloak:8080
# KEYCLOAK_PUBLIC_URL - public URL for browser redirects (outside Docker)
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_REALM=reports-realm
KEYCLOAK_CLIENT_ID=bionicpro-bff
KEYCLOAK_CLIENT_SECRET=your-client-secret-here

# BFF Configuration
BFF_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# API Configuration
API_URL=http://api:8000

# Session Configuration
SESSION_SECRET=your-session-secret-change-this-in-production
COOKIE_DOMAIN=localhost
