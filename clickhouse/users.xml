<yandex>
    <users>
        <!-- Настройка пользователя default с паролем -->
        <default>
            <!-- Пароль в открытом виде (не рекомендуется для продакшена) -->
            <password></password>

            <!-- Ограничение доступа по сети -->
            <networks>
                <ip>::/0</ip> <!-- Доступ со всех IP (настройте по необходимости) -->
                <!-- <ip>127.0.0.1</ip> --> <!-- Только localhost -->
                <!-- <ip>192.168.0.0/16</ip> --> <!-- Только из локальной сети -->
            </networks>

            <!-- Профиль настроек -->
            <profile>default</profile>

            <!-- Квота -->
            <quota>default</quota>

            <!-- Настройки доступа -->
            <access_management>0</access_management>
        </default>
    </users>
</yandex>