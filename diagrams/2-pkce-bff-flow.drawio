<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/25.0.2 Chrome/128.0.6613.186 Electron/32.2.5 Safari/537.36" version="25.0.2">
  <diagram id="pkce-bff" name="PKCE BFF Flow">
    <mxGraphModel dx="1290" dy="911" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="980" pageHeight="650" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Задание 1: PKCE + BFF — поток аутентификации и работы с сессией" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#333333;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="80" y="5" width="820" height="15" as="geometry" />
        </mxCell>
        <mxCell id="p-browser" value="Browser / Frontend" style="rounded=0;strokeColor=#d6b656;fillColor=#fff2cc;fontSize=11;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="20" y="30" width="150" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p-auth" value="bionicpro-auth (BFF)" style="rounded=0;strokeColor=#d6b656;fillColor=#fff2cc;fontSize=11;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="240" y="30" width="165" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p-kc" value="Keycloak" style="rounded=0;strokeColor=#d6b656;fillColor=#fff2cc;fontSize=11;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="490" y="30" width="140" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p-api" value="Report API" style="rounded=0;strokeColor=#d6b656;fillColor=#fff2cc;fontSize=11;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="730" y="30" width="130" height="30" as="geometry" />
        </mxCell>
        <mxCell id="ll-b" style="endArrow=none;dashed=1;strokeColor=#999999;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="95" y="60" as="sourcePoint" />
            <mxPoint x="95" y="618" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ll-a" style="endArrow=none;dashed=1;strokeColor=#999999;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="322" y="60" as="sourcePoint" />
            <mxPoint x="322" y="618" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ll-k" style="endArrow=none;dashed=1;strokeColor=#999999;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="560" y="60" as="sourcePoint" />
            <mxPoint x="560" y="618" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ll-r" style="endArrow=none;dashed=1;strokeColor=#999999;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="795" y="60" as="sourcePoint" />
            <mxPoint x="795" y="618" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="a1" value="1. GET /auth/login" style="endArrow=classic;strokeColor=#333333;fontSize=10;fontColor=#333333;align=center;verticalAlign=bottom;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="95" y="90" as="sourcePoint" />
            <mxPoint x="322" y="90" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n2a" value="2. generate code_verifier (random 32 bytes)" style="rounded=0;strokeColor=#666666;fillColor=#f5f5f5;fontSize=8;fontColor=#333333;fontStyle=2;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="330" y="100" width="170" height="10" as="geometry" />
        </mxCell>
        <mxCell id="n2b" value="3. code_challenge = BASE64URL(SHA256(verifier))" style="rounded=0;strokeColor=#666666;fillColor=#f5f5f5;fontSize=8;fontColor=#333333;fontStyle=2;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="330" y="130" width="210" height="10" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="4. redirect → /authorize?code_challenge&amp;method=S256&amp;state" style="endArrow=classic;strokeColor=#333333;fontSize=10;fontColor=#333333;align=center;verticalAlign=bottom;dashed=1;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="322" y="160" as="sourcePoint" />
            <mxPoint x="95" y="160" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="a4" value="5. GET /authorize (browser redirect)" style="endArrow=classic;strokeColor=#333333;fontSize=10;fontColor=#333333;align=center;verticalAlign=bottom;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="95" y="200" as="sourcePoint" />
            <mxPoint x="560" y="200" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="a5" value="6. login page + MFA/OTP" style="endArrow=classic;strokeColor=#333333;fontSize=10;fontColor=#333333;align=center;verticalAlign=bottom;dashed=1;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="560" y="240" as="sourcePoint" />
            <mxPoint x="95" y="240" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="a6" value="7. credentials + OTP-код" style="endArrow=classic;strokeColor=#333333;fontSize=10;fontColor=#333333;align=center;verticalAlign=bottom;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="95" y="280" as="sourcePoint" />
            <mxPoint x="560" y="280" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="a7" value="8. redirect callback?code=AUTH_CODE&amp;state" style="endArrow=classic;strokeColor=#333333;fontSize=10;fontColor=#333333;align=center;verticalAlign=bottom;dashed=1;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="560" y="320" as="sourcePoint" />
            <mxPoint x="322" y="320" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="a8" value="9. POST /token  {code, code_verifier}  (server-to-server, конфиденциально)" style="endArrow=classic;strokeColor=#333333;fontSize=10;fontColor=#333333;align=center;verticalAlign=bottom;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="322" y="360" as="sourcePoint" />
            <mxPoint x="560" y="360" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="a9" value="10. {access_token (2 мин), refresh_token}" style="endArrow=classic;strokeColor=#333333;fontSize=10;fontColor=#333333;align=center;verticalAlign=bottom;dashed=1;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="560" y="400" as="sourcePoint" />
            <mxPoint x="322" y="400" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n10" value="11. store tokens in memory, create session_id" style="rounded=0;strokeColor=#666666;fillColor=#f5f5f5;fontSize=10;fontColor=#333333;fontStyle=2;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="330" y="410" width="213" height="10" as="geometry" />
        </mxCell>
        <mxCell id="a10" value="12. Set-Cookie: session=SESSION_ID (HttpOnly, Secure, SameSite=Lax)" style="endArrow=classic;strokeColor=#333333;fontSize=10;fontColor=#333333;align=center;verticalAlign=bottom;dashed=1;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="322" y="445" as="sourcePoint" />
            <mxPoint x="95" y="445" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sep" value="" style="endArrow=none;dashed=1;strokeColor=#999999;strokeWidth=2;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="20" y="470" as="sourcePoint" />
            <mxPoint x="940" y="470" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sep-label" value="— следующий запрос к защищённому ресурсу —" style="text;html=1;fontSize=9;fontStyle=2;fontColor=#999999;align=center;" parent="1" vertex="1">
          <mxGeometry x="330" y="450" width="320" height="16" as="geometry" />
        </mxCell>
        <mxCell id="a11" value="13. GET /api/reports  + Cookie: session=SESSION_ID" style="endArrow=classic;strokeColor=#333333;fontSize=10;fontColor=#333333;align=center;verticalAlign=bottom;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="95" y="495" as="sourcePoint" />
            <mxPoint x="322" y="495" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n12" value="14. validate session, check token_expiry → if expired: refresh via refresh_token" style="rounded=0;strokeColor=#666666;fillColor=#f5f5f5;fontSize=9;fontColor=#333333;fontStyle=2;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="330" y="500" width="320" height="10" as="geometry" />
        </mxCell>
        <mxCell id="a12" value="15. GET /reports  Authorization: Bearer access_token" style="endArrow=classic;strokeColor=#333333;fontSize=10;fontColor=#333333;align=center;verticalAlign=bottom;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="322" y="540" as="sourcePoint" />
            <mxPoint x="795" y="540" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="a13" value="16. {report_data}" style="endArrow=classic;strokeColor=#333333;fontSize=10;fontColor=#333333;align=center;verticalAlign=bottom;dashed=1;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="795" y="575" as="sourcePoint" />
            <mxPoint x="322" y="575" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="a14" value="17. Set-Cookie: session=NEW_SESSION_ID (ротация) + {data}" style="endArrow=classic;strokeColor=#333333;fontSize=10;fontColor=#333333;align=center;verticalAlign=bottom;dashed=1;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="322" y="605" as="sourcePoint" />
            <mxPoint x="95" y="605" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="note" value="Dashed = response/redirect   |   Ротация session_id (шаг 17) предотвращает Session Fixation Attack   |   access_token живёт 2 мин, хранится только в памяти BFF" style="text;html=1;fontSize=10;fontStyle=2;fontColor=#666666;align=left;" parent="1" vertex="1">
          <mxGeometry x="30" y="620" width="750" height="18" as="geometry" />
        </mxCell>
      </root>
