            <mxPoint x="100" y="155" as="targetPoint" />
            <mxPoint y="-5" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n1" value="1. CRM: INSERT/UPDATE/DELETE → PostgreSQL WAL (Write-Ahead Log)" style="rounded=0;strokeColor=#6c8ebf;fillColor=#dae8fc;fontSize=10;fontStyle=2;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="115" y="150" width="345" height="13" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="2. Debezium читает WAL (logical replication)" style="endArrow=classic;strokeColor=#333333;fontSize=10;fontColor=#333333;align=center;verticalAlign=bottom;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="100" y="185" as="sourcePoint" />
            <mxPoint x="345" y="185" as="targetPoint" />
