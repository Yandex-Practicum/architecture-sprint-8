            <mxPoint x="775" y="275" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n4" value="ENGINE = Kafka SETTINGS kafka_broker_list = &#39;kafka:9092&#39;, kafka_topic_list = &#39;bionicpro.public.crm_orders&#39;" style="rounded=0;strokeColor=#999999;fillColor=none;fontSize=10;fontColor=#666666;fontStyle=2;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="115" y="293" width="630" height="20" as="geometry" />
        </mxCell>
        <mxCell id="n5-label" value="5. MaterializedView агрегирует &#xa;данные в витрину:" style="rounded=0;strokeColor=#999999;fillColor=none;fontSize=9;fontColor=#666666;fontStyle=2;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="780" y="330" width="140" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="5. MaterializedView: INSERT INTO user_reports_summary SELECT ..." style="rounded=0;strokeColor=#333333;fillColor=none;fontSize=10;fontColor=#333333;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="115" y="340" width="640" height="20" as="geometry" />
        </mxCell>
        <mxCell id="a5" value="6. Report API SELECT из витрины (мгновенно)" style="endArrow=classic;strokeColor=#333333;fontSize=10;fontColor=#333333;align=center;verticalAlign=bottom;dashed=1;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="775" y="400" as="sourcePoint" />
            <mxPoint x="565" y="400" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="benefit-box" value="Зачем CDC вместо прямых запросов к CRM:&#xa;- OLTP-запросы (CRM) и OLAP-запросы (отчёты) не конкурируют за ресурсы&#xa;- Тяжёлые аналитические запросы не тормозят операции CRM&#xa;- ClickHouse оптимизирован для колоночного хранения и агрегаций" style="rounded=0;strokeColor=#666666;fillColor=#f5f5f5;fontSize=10;fontColor=#333333;fontStyle=2;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="30" y="420" width="870" height="60" as="geometry" />
        </mxCell>
      </root>
