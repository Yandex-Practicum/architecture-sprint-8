        <mxCell id="title" value="Задание 4: CDC — Debezium → Kafka → ClickHouse (разделение OLTP и OLAP нагрузок)" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#333333;align=center;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1">
