          <mxGeometry x="350" y="180" width="310" height="15" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="3. produce: JSON event {op, before, after, ts}" style="endArrow=classic;strokeColor=#333333;fontSize=10;fontColor=#333333;align=center;verticalAlign=bottom;" parent="1" edge="1">
