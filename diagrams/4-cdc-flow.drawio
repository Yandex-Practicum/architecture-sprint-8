        <mxCell id="a1" value="1. INSERT / UPDATE / DELETE в таблицах CRM" style="endArrow=none;strokeColor=#999999;fontSize=8;fontColor=#666666;fontStyle=2;align=center;verticalAlign=bottom;" parent="1" edge="1">
          <mxGeometry x="NaN" y="5" relative="1" as="geometry">
