        </mxCell>
        <mxCell id="a4" value="4. ClickHouse KafkaEngine читает топик" style="endArrow=classic;strokeColor=#333333;fontSize=10;fontColor=#333333;align=center;verticalAlign=bottom;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
