                <mxCell id="raw" value="MergeTree&#10;telemetry_raw (сырьё)&#10;clients_dim (ReplacingMergeTree)&#10;&lt;- MATERIALIZED VIEW из очередей" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;fontColor=#000000;" parent="1" vertex="1">
