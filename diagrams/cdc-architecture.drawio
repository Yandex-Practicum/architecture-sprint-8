                </mxCell>
                <mxCell id="crm" value="CRM PostgreSQL&#10;(OLTP)&#10;wal_level = logical&#10;таблицы telemetry, clients" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="30" y="120" width="180" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="dbz" value="Debezium&#10;(Kafka Connect)&#10;PostgresConnector, pgoutput&#10;snapshot + streaming&#10;SMT unwrap → плоский JSON" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;fontColor=#000000;" parent="1" vertex="1">
