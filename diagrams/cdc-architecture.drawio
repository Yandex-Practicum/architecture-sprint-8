                <mxCell id="title" value="BionicPRO — CDC: разделение OLTP и выгрузки. Изменения CRM в реальном времени в витрину ClickHouse" style="text;html=1;fontSize=15;fontStyle=1;align=left;fillColor=#ffffff;strokeColor=none;fontColor=#000000;" parent="1" vertex="1">
