<mxfile host="app.diagrams.net" type="device">
  <diagram name="Load reduction (S3 + CDN)" id="load-reduction">
    <mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="BionicPRO — Снижение нагрузки на OLAP: кеш отчётов в S3 + раздача через CDN" style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=none;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="30" as="geometry" />
        </mxCell>

        <mxCell id="user" value="Пользователь&#10;(браузер / Android)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="140" height="70" as="geometry" />
        </mxCell>

        <mxCell id="front" value="Frontend (React)&#10;кнопка «Download Report»" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="140" height="70" as="geometry" />
        </mxCell>

        <mxCell id="api" value="reports-api (FastAPI)&#10;GET /reports&#10;— доступ только к своим данным&#10;— версия витрины → ключ отчёта" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="320" y="230" width="240" height="90" as="geometry" />
        </mxCell>

        <mxCell id="ch" value="ClickHouse (OLAP)&#10;витрина reports.user_report&#10;— max(processed_at) = версия&#10;— полный отчёт только при cache-miss" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="680" y="120" width="260" height="90" as="geometry" />
        </mxCell>

        <mxCell id="s3" value="S3 / Minio (bucket reports)&#10;ключ: reports/{username}/{version}.json&#10;— готовые отчёты&#10;— анонимное чтение для CDN" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="680" y="250" width="260" height="90" as="geometry" />
        </mxCell>

        <mxCell id="cdn" value="CDN (Nginx reverse proxy)&#10;proxy_cache перед Minio&#10;— кеширует 200 по URL&#10;— X-Cache-Status: HIT/MISS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="680" y="380" width="260" height="80" as="geometry" />
        </mxCell>

        <mxCell id="etl" value="Airflow ETL (по расписанию)&#10;CRM → витрина ClickHouse&#10;новый прогон → новый processed_at → новая версия" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;dashed=1;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="320" y="120" width="240" height="70" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="endArrow=classic;html=1;" edge="1" parent="1" source="user" target="front">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="cookie-сессия" style="endArrow=classic;html=1;fontSize=10;fontColor=#000000;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="front" target="api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="1. версия витрины&#10;(лёгкий запрос)" style="endArrow=classic;html=1;fontSize=10;fontColor=#000000;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="api" target="ch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="2. есть объект? (HEAD)&#10;4b. если нет — PUT отчёт" style="endArrow=classic;html=1;fontSize=10;fontColor=#000000;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="api" target="s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="3. ответ: ссылка на CDN" style="endArrow=classic;html=1;fontSize=10;dashed=1;fontColor=#000000;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="api" target="cdn">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="5. скачивание отчёта&#10;(кеш CDN, минуя OLAP)" style="endArrow=classic;html=1;fontSize=10;fontColor=#000000;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="front" target="cdn">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="110" y="640" />
              <mxPoint x="810" y="640" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e7" value="proxy_pass (при miss)" style="endArrow=classic;html=1;fontSize=10;fontColor=#000000;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cdn" target="s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" style="endArrow=classic;html=1;dashed=1;" edge="1" parent="1" source="etl" target="ch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="note" value="Инвалидация кеша: ключ отчёта включает версию витрины (max processed_at). Новый прогон ETL → новая версия → новый ключ → cache-miss → отчёт пересобирается один раз и снова кешируется в S3 и CDN." style="text;html=1;fontSize=11;align=left;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="690" width="900" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
