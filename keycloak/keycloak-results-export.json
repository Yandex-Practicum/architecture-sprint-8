  "clients": [
    {
      "clientId": "bionicpro-auth",
      "name": "bionicpro-auth",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "fullScopeAllowed": true,
      "redirectUris": [
        "__AUTH_CALLBACK_URL__"
      ],
      "webOrigins": [
        "__FRONTEND_BASE_URL__"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "exclude.session.state.from.auth.response": "false",
        "backchannel.logout.session.required": "true",
        "post.logout.redirect.uris": "__POST_LOGOUT_REDIRECT_URIS__"
      },
      "defaultClientScopes": [
        "web-origins",
        "roles",
        "profile",
        "email"
      ],
      "optionalClientScopes": [
        "offline_access",
        "microprofile-jwt"
      ],
      "protocolMappers": [
        {
          "name": "identity_provider",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "consentRequired": false,
          "config": {
            "user.session.note": "identity_provider",
            "claim.name": "identity_provider",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "identity_provider_identity",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "consentRequired": false,
          "config": {
            "user.session.note": "identity_provider_identity",
            "claim.name": "identity_provider_identity",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
