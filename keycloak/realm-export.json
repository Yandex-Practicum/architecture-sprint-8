        "lastName": "Three",
        "credentials": [
          {
            "type": "password",
            "value": "prothetic123",
            "temporary": false
          }
        ],
        "realmRoles": [
          "prothetic_user"
        ]
      }
    ],
    "clients": [
      {
        "clientId": "reports-api",
        "enabled": true,
        "clientAuthenticatorType": "client-secret",
        "secret": "oNwoLQdvJAvRcL89SydqCWCe5ry1jMgq",
        "bearerOnly": true
      },
      {
        "clientId": "bionicpro-auth",
        "enabled": true,
        "fullScopeAllowed": true,
        "bearerOnly": false,
        "clientAuthenticatorType": "client-secret",
        "secret": "bionicpro-auth-secret-change-in-prod",
        "publicClient": false,
        "consentRequired": false,
        "standardFlowEnabled": true,
        "implicitFlowEnabled": false,
        "directAccessGrantsEnabled": false,
        "serviceAccountsEnabled": false,
        "redirectUris": [
          "http://localhost:8181/login/oauth2/code/keycloak",
          "http://127.0.0.1:8181/login/oauth2/code/keycloak",
          "http://localhost:8181/*",
          "http://127.0.0.1:8181/*"
        ],
        "webOrigins": [
          "http://localhost:8181",
          "http://localhost:3000"
        ],
        "protocol": "openid-connect",
        "attributes": {
          "post.logout.redirect.uris": "http://localhost:3000/*",
          "pkce.code.challenge.method": "S256"
        }
      }
    ],
    "identityProviders": [
      {
        "alias": "yandex",
        "providerId": "oauth2",
        "enabled": true,
        "trustEmail": true,
        "storeToken": true,
        "addReadTokenRoleOnCreate": false,
        "authenticateByDefault": false,
        "linkOnly": false,
        "firstBrokerLoginFlowAlias": "first broker login",
        "config": {
          "hideOnLoginPage": "false",
          "clientId": "${YANDEX_OAUTH_CLIENT_ID}",
          "clientSecret": "${YANDEX_OAUTH_CLIENT_SECRET}",
          "authorizationUrl": "https://oauth.yandex.ru/authorize",
          "tokenUrl": "https://oauth.yandex.ru/token",
          "userInfoUrl": "https://login.yandex.ru/info",
          "clientAuthMethod": "client_secret_post",
          "defaultScope": "login:email login:info",
          "userIDClaim": "id",
          "userNameClaim": "login",
          "emailClaim": "default_email",
          "givenNameClaim": "first_name",
          "familyNameClaim": "last_name",
          "fullNameClaim": "display_name",
          "syncMode": "IMPORT",
          "disableUserInfo": "false",
          "validateSignature": "false",
          "backchannelSupported": "false",
          "filteredByClaim": "false"
        }
      }
    ],
    "identityProviderMappers": [
      {
        "name": "yandex-email",
        "identityProviderAlias": "yandex",
        "identityProviderMapper": "oidc-user-attribute-idp-mapper",
        "config": {
          "syncMode": "INHERIT",
          "claim": "default_email",
          "user.attribute": "email"
        }
      },
      {
        "name": "yandex-display-name",
        "identityProviderAlias": "yandex",
        "identityProviderMapper": "oidc-user-attribute-idp-mapper",
        "config": {
          "syncMode": "INHERIT",
          "claim": "display_name",
          "user.attribute": "firstName"
        }
      }
    ]
}
