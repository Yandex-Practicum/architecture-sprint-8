{
  "realm": "reports-realm",
  "enabled": true,
  "accessTokenLifespan": 120,
  "ssoSessionIdleTimeout": 3600,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      { "name": "user",           "description": "Regular user role" },
      { "name": "administrator",  "description": "Administrator role" },
      { "name": "prothetic_user", "description": "Prothetic user with report access" }
    ]
  },
  "users": [
    {
      "username": "user1", "enabled": true,
      "email": "user1@example.com", "firstName": "User", "lastName": "One",
      "credentials": [{ "type": "password", "value": "password123", "temporary": false }],
      "realmRoles": ["user"],
      "requiredActions": ["CONFIGURE_TOTP"]
    },
    {
      "username": "prothetic1", "enabled": true,
      "email": "prothetic1@example.com", "firstName": "Prothetic", "lastName": "One",
      "credentials": [{ "type": "password", "value": "prothetic123", "temporary": false }],
      "realmRoles": ["prothetic_user"],
      "requiredActions": ["CONFIGURE_TOTP"]
    },
    {
      "username": "prothetic2", "enabled": true,
      "email": "prothetic2@example.com", "firstName": "Prothetic", "lastName": "Two",
      "credentials": [{ "type": "password", "value": "prothetic123", "temporary": false }],
      "realmRoles": ["prothetic_user"],
      "requiredActions": ["CONFIGURE_TOTP"]
    },
    {
      "username": "admin1", "enabled": true,
      "email": "admin1@example.com", "firstName": "Admin", "lastName": "One",
      "credentials": [{ "type": "password", "value": "admin123", "temporary": false }],
      "realmRoles": ["administrator"]
    }
  ],
  "clients": [
    {
      "clientId": "bionicpro-auth",
      "enabled": true,
      "publicClient": false,
      "secret": "bionicpro-auth-secret",
      "redirectUris": ["http://localhost:8001/auth/callback"],
      "webOrigins": ["http://localhost:8001"],
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "access.token.lifespan": "120"
      }
    },
    {
      "clientId": "reports-api",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "oNwoLQdvJAvRcL89SydqCWCe5ry1jMgq",
      "bearerOnly": true
    }
  ],
  "browserFlow": "browser",
  "authenticationFlows": [
    {
      "alias": "browser",
      "description": "Browser flow with OTP",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "auth-cookie",                    "requirement": "ALTERNATIVE", "priority": 10 },
        { "authenticator": "auth-spnego",                    "requirement": "DISABLED",    "priority": 20 },
        { "authenticator": "identity-provider-redirector",   "requirement": "ALTERNATIVE", "priority": 25 },
        { "flowAlias": "forms", "requirement": "ALTERNATIVE", "priority": 30, "authenticatorFlow": true, "autheticatorFlow": true }
      ]
    },
    {
      "alias": "forms",
      "description": "Username, Password and OTP form",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "auth-username-password-form", "requirement": "REQUIRED", "priority": 10 },
        { "authenticator": "auth-otp-form",               "requirement": "REQUIRED", "priority": 20 }
      ]
    }
  ],
  "components": {
    "org.keycloak.storage.UserStorageProvider": [
      {
        "name": "ldap",
        "providerId": "ldap",
        "config": {
          "enabled":              ["true"],
          "priority":             ["0"],
          "vendor":               ["other"],
          "connectionUrl":        ["ldap://openldap:389"],
          "bindDn":               ["cn=admin,dc=bionicpro,dc=com"],
          "bindCredential":       ["admin"],
          "usersDn":              ["ou=users,dc=bionicpro,dc=com"],
          "usernameLDAPAttribute": ["uid"],
          "rdnLDAPAttribute":     ["uid"],
          "uuidLDAPAttribute":    ["entryUUID"],
          "userObjectClasses":    ["inetOrgPerson"],
          "searchScope":          ["1"],
          "editMode":             ["READ_ONLY"],
          "syncRegistrations":    ["false"]
        }
      }
    ]
  },
  "identityProviders": [
    {
      "alias": "yandex",
      "displayName": "Yandex ID",
      "providerId": "oidc",
      "enabled": true,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "authorizationUrl":  "https://oauth.yandex.ru/authorize",
        "tokenUrl":          "https://oauth.yandex.ru/token",
        "userInfoUrl":       "https://login.yandex.ru/info",
        "clientId":          "YOUR_YANDEX_CLIENT_ID",
        "clientSecret":      "YOUR_YANDEX_CLIENT_SECRET",
        "defaultScope":      "login:email login:info",
        "syncMode":          "IMPORT",
        "storeToken":        "true"
      }
    }
  ]
}
