        ]
      },
      {
        "username": "admin1",
        "enabled": true,
        "email": "admin1@example.com",
        "firstName": "Admin",
        "lastName": "One",
        "credentials": [
          {
            "type": "password",
            "value": "admin123",
            "temporary": false
          }
        ],
        "realmRoles": [
          "administrator"
        ]
      },
      {
        "username": "prothetic1",
        "enabled": true,
        "email": "prothetic1@example.com",
        "firstName": "Prothetic",
        "lastName": "One",
        "credentials": [
          {
            "type": "password",
            "value": "prothetic123",
            "temporary": false
          }
        ],
