{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CLICKHOUSE_HOST": "localhost",
  "CLICKHOUSE_PORT": 8123,
  "CLICKHOUSE_DB": "bionic",
  "CLICKHOUSE_USER": "clickhouse",
  "CLICKHOUSE_PASSWORD": "clickhouse",


  "Keycloak": {
    // ссылка на realm - тут будем получать и рефрешить токены
    "AuthorityURL": "http://localhost:8080/realms/reports-realm",

    // ссылка на endpoint в котором предоставляется инфа о точках аутентификации/авторизации и 
    // публичные ключи IDP
    "MetadataURL": "http://localhost:8080/realms/reports-realm/.well-known/openid-configuration",

    // Наш сервис как "аудитория" (пока не используется)
    "Audience": "reports-backend",

    // целевой издатель сертификата. Используем ссылку на realm
    "ValidIssuer": "http://localhost:8080/realms/reports-realm",

    // Целевая "аудитория" в токене. Требует включения кастомного Маппера в Клиенте на keycloak
    // указываем идентификатор сервиса, который исходно __получил__ токен и отдает его нам на проверку
    "ValidAudience": "reports-frontend"
  },
  "FrontendURL": "http://localhost:3000"
}
